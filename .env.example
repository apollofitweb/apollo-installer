# Apollo Installer - Environment Variables Example
# Copy to .env and fill in values. NEVER commit real secrets.

# Application
NODE_ENV=development
PORT=3334
APP_URL=http://localhost:3334

# Database (SQLite for local dev, PostgreSQL for production)
# For local development, use SQLite file. For production, use PostgreSQL connection string.
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://user:pass@host:5432/db"  # For migrations in production

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# Public API URL (for webhooks, Swagger)
PUBLIC_API_URL=http://localhost:3334

# Adapter placeholders (NOT USED IN OS-002 - interfaces only)
# SUPABASE_ACCESS_TOKEN=
# RENDER_API_TOKEN=
# NETLIFY_AUTH_TOKEN=

# Logging
LOG_LEVEL=debug