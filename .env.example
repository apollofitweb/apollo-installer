# Apollo Installer - Environment Variables Example
# Copy to .env and fill in values. NEVER commit real secrets.

# Application
NODE_ENV=development
PORT=3334
APP_URL=http://localhost:3334

# Database (SQLite for local dev, PostgreSQL for production)
# For local development, use SQLite file. For production, use PostgreSQL connection string.
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://user:pass@host:5432/db"  # For migrations in production

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin UI login
ADMIN_EMAIL=admin@apollofit.com.br
# Use ADMIN_PASSWORD (plain) OR ADMIN_PASSWORD_HASH (bcrypt). At least one is required.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL=12h

# Encryption key for the durable secret store (AES-256-GCM, base64 of 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# Public API URL (for webhooks, Swagger)
PUBLIC_API_URL=http://localhost:3334

# ===== Real adapters (production / NODE_ENV=production) =====
# Prefer provisioning these as GLOBAL secrets via the admin UI/CLI:
#   supabase.accessToken, netlify.authToken, netlify.siteId, render.apiToken
# Environment variables below are optional fallbacks for Render.
# SUPABASE_ACCESS_TOKEN=
# NETLIFY_AUTH_TOKEN=
# RENDER_API_TOKEN=
# RENDER_OWNER_ID=
# RENDER_REGION=oregon
# RENDER_PLAN=starter

# ===== Migrations/seed source paths (optional) =====
# Default resolution tries: ../apollo-web/apps/api/prisma, ./apps/api/prisma, ./prisma
# SUPABASE_MIGRATIONS_DIR=
# SUPABASE_SEED_SQL_PATH=

# Logging
LOG_LEVEL=debug