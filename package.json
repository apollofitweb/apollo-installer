{
  "name": "apollo-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Instalador Automatizado de Novas Filiais Apollo Fit - Projeto Independente",
  "type": "module",
  "engines": {
    "node": "20.19.5",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc",
    "start": "node dist/api/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "admin": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^6.0.0",
    "commander": "12.1.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0"
  }
}